{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "campboard",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		// Without this the static-asset layer answers POST requests itself and
		// /api/ingest never reaches the worker (it 404s).
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "campboard",
			"database_id": "196c0437-df4e-4465-83c0-318612f77c3e"
		}
	],
	"observability": {
		"enabled": true
	}
}
