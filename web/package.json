    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
