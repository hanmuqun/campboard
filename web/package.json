{
  "name": "campboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "data": "node scripts/sync-data.mjs",
    "dev": "node scripts/sync-data.mjs && vite dev",
    "prebuild": "node scripts/sync-data.mjs",
